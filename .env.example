# Local development only. Copy to .env and keep that file untracked.
# manage.py selects local settings before this file is loaded. Set
# DJANGO_SETTINGS_MODULE or DJANGO_LOAD_DOTENV in the process environment
# when overriding entrypoint selection or disabling .env loading.
DJANGO_ENABLE_ADMIN=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=maritimeos
POSTGRES_USER=maritimeos
POSTGRES_PASSWORD=maritimeos-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=0

# Production uses config.settings.production and requires values supplied by
# the deployment environment. Never put production values in this file:
# DJANGO_SETTINGS_MODULE
# DJANGO_SECRET_KEY
# DJANGO_ALLOWED_HOSTS
# DJANGO_CSRF_TRUSTED_ORIGINS
# DJANGO_HSTS_SECONDS
# DJANGO_HSTS_INCLUDE_SUBDOMAINS
# DJANGO_HSTS_PRELOAD
# DJANGO_TRUST_PROXY_SSL_HEADER
# DJANGO_ENABLE_ADMIN
# POSTGRES_DB
# POSTGRES_USER
# POSTGRES_PASSWORD
# POSTGRES_HOST
# POSTGRES_PORT
# POSTGRES_SSLMODE
# POSTGRES_CONN_MAX_AGE
